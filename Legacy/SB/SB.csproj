<Project>
  <!-- This needs to be set before Sdk.props -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>../../build/.sb/SB/obj</BaseIntermediateOutputPath>
    <BaseOutputPath>../../build/.sb/SB/bin</BaseOutputPath>
    <EnableDefaultItems>false</EnableDefaultItems>
    <DefaultItemExcludesInProjectFolder>$(DefaultItemExcludesInProjectFolder);**/*</DefaultItemExcludesInProjectFolder>
  </PropertyGroup>

  <!-- Target configure -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- SDKs -->
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <ItemGroup>
    <Compile Include="run_build.cs" />
  </ItemGroup>

  <!-- SB Engine/Core -->
  <ItemGroup>
    <ProjectReference Include="SB.Engine\SB.Engine.csproj" />
  </ItemGroup>

</Project>
